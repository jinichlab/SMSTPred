# RNA-7 KKNIKLNK - tRNA (guanine(37)-N(1))-methyltransf (2ZZM; X-ray; SAM + RNA) - distal.  Open:  chimerax view.cxc
open rna_motif7_2ZZM.pdb
set bgColor white
hide atoms
cartoon
color #1 #b0b0b0
color /B #9c7a5b
show ligand
style ligand stick
color ligand byelement
color :0XU,NEA,QVR,SAH,SAM,SFG #b5651d
color :0XU,NEA,QVR,SAH,SAM,SFG byhetero
hide /B atoms
color /A:233-240 #cb181d
show /A:233-240 atoms
style /A:233-240 stick
color /A:233-240 byhetero
hbonds /A:233-240 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA-7 KKNIKLNK - tRNA (guanine(37)-N(1))-methyltransf (2ZZM; X-ray; SAM + RNA) - distal" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
