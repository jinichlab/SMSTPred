# RNA-6 ENEEQVAWALT - tRNA (cytosine(72)-C(5))-methyltrans (5WWR; X-ray; SFG + RNA) - distal.  Open:  chimerax view.cxc
open rna_motif6_5WWR.pdb
set bgColor white
hide atoms
cartoon
color #1 #b0b0b0
color /C #9c7a5b
show ligand
style ligand stick
color ligand byelement
color :0XU,NEA,QVR,SAH,SAM,SFG #b5651d
color :0XU,NEA,QVR,SAH,SAM,SFG byhetero
hide /C atoms
color /A:379-389 #cb181d
show /A:379-389 atoms
style /A:379-389 stick
color /A:379-389 byhetero
hbonds /A:379-389 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA-6 ENEEQVAWALT - tRNA (cytosine(72)-C(5))-methyltrans (5WWR; X-ray; SFG + RNA) - distal" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
