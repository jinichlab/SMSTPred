# RNA-5 SIGFFIAKF - tRNA (cytosine(72)-C(5))-methyltrans (5WWR; X-ray; SFG + RNA) - near substrate.  Open:  chimerax view.cxc
open rna_motif5_5WWR.pdb
set bgColor white
hide atoms
cartoon
color #1 #b0b0b0
color /C #9c7a5b
show ligand
style ligand stick
color ligand byelement
color :0XU,NEA,QVR,SAH,SAM,SFG #b5651d
color :0XU,NEA,QVR,SAH,SAM,SFG byhetero
hide /C atoms
color /A:455-463 #cb181d
show /A:455-463 atoms
style /A:455-463 stick
color /A:455-463 byhetero
hbonds /A:455-463 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA-5 SIGFFIAKF - tRNA (cytosine(72)-C(5))-methyltrans (5WWR; X-ray; SFG + RNA) - near substrate" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
