# Protein-5 THWKQTVFYM - Protein arginine N-methyltransferase (1OR8; X-ray; SAH + partner protein) - near substrate.  Open:  chimerax view.cxc
open protein_motif5_1OR8.pdb
set bgColor white
hide atoms
cartoon
color #1 #b0b0b0
color /B #d9b38c
show ligand
style ligand stick
color ligand byelement
color :0XU,NEA,QVR,SAH,SAM,SFG #b5651d
color :0XU,NEA,QVR,SAH,SAM,SFG byhetero
color /A:292-301 #238b45
show /A:292-301 atoms
style /A:292-301 stick
color /A:292-301 byhetero
hbonds /A:292-301 restrict /B | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Protein-5 THWKQTVFYM - Protein arginine N-methyltransferase (1OR8; X-ray; SAH + partner protein) - near substrate" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
