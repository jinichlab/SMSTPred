# T4 Dam (P04392) IG on DNA-bound 1YF3.  Open: chimerax view.cxc
open P04392_IG.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:127,117,114,126,124,123,128,122,77,10 #cb181d
show /A:127,117,114,126,124,123,128,122,77,10 atoms
