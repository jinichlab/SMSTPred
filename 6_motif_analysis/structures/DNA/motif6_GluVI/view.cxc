# FLLENVPGL - catalytic Glu119.  Open:  chimerax motif6_GluVI/view.cxc
open motif6_GluVI.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:116-124 #e6550d
show /A:116-124 atoms
style /A:116-124 stick
color /A:116-124 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:116-124 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif6 FLLENVPGL  (catalytic Glu119)" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif6.png width 2400 height 1800 supersample 3
