# LTPREAARLQGFPDDYTF - cofactor-proximal.  Open:  chimerax motif4_TRD/view.cxc
open motif4_TRD.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:274-291 #6a51a3
show /A:274-291 atoms
style /A:274-291 stick
color /A:274-291 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:274-291 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif4 LTPREAARLQGFPDDYTF  (cofactor-proximal)" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif4.png width 2400 height 1800 supersample 3
