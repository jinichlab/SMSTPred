# IGGPPCQGFSRAG - catalytic PCQ (Cys81).  Open:  chimerax motif1_PCQ/view.cxc
open motif1_PCQ.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:76-88 #cb181d
show /A:76-88 atoms
style /A:76-88 stick
color /A:76-88 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:76-88 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif1 IGGPPCQGFSRAG  (catalytic PCQ (Cys81))" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif1.png width 2400 height 1800 supersample 3
