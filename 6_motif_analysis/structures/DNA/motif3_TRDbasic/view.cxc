# YGVPQRRERVF - TRD DNA-contact.  Open:  chimerax motif3_TRDbasic/view.cxc
open motif3_TRDbasic.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:157-167 #238b45
show /A:157-167 atoms
style /A:157-167 stick
color /A:157-167 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:157-167 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif3 YGVPQRRERVF  (TRD DNA-contact)" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif3.png width 2400 height 1800 supersample 3
