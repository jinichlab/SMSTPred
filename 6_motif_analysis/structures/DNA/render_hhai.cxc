open 1MHT.pdb
set bgColor white
hide atoms
cartoon
color #1 #cccccc
select nucleic
color sel #9c7a5b
~select
show ligand
style ligand stick
color ligand byelement
color /A:17-24 #2171b5
color /A:76-88 #cb181d
color /A:116-124 #e6550d
color /A:157-167 #238b45
color /A:274-291 #6a51a3
color /A:300-315 #ce1256
view
lighting soft
graphics silhouettes true
save 1mht_motifs.png width 2000 height 1500 supersample 3
exit
