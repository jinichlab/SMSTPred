# PFAGSGGT - SAM Motif I loop.  Open:  chimerax motif2_SAMloop/view.cxc
open motif2_SAMloop.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:17-24 #2171b5
show /A:17-24 atoms
style /A:17-24 stick
color /A:17-24 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:17-24 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif2 PFAGSGGT  (SAM Motif I loop)" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif2.png width 2400 height 1800 supersample 3
