# KQIGNAVPPPVARA - DNA-cofactor junction.  Open:  chimerax motif5_TRD/view.cxc
open motif5_TRD.pdb
set bgColor white
hide atoms
cartoon
color /A #b0b0b0
color /A:300-315 #ce1256
show /A:300-315 atoms
style /A:300-315 stick
color /A:300-315 byhetero
color nucleic #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:300-315 restrict nucleic | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "motif5 KQIGNAVPPPVARA  (DNA-cofactor junction)" xpos .03 ypos .04 size 16
lighting soft
graphics silhouettes true
view
# >>> rotate to taste, then:  save motif5.png width 2400 height 1800 supersample 3
