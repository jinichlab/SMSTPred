# RNA RsmF region (apo).  Open: chimerax view.cxc
open rna_motif4.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:85-101 #6a51a3
show /A:85-101 atoms
style /A:85-101 stick
color /A:85-101 byhetero
label /A:85-101 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "RNA motif4: RsmF region (apo)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save rna_motif4.png width 2400 height 1800 supersample 3
