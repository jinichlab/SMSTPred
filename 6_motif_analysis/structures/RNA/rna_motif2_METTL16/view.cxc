# RNA METTL16 catalytic region (m6A snRNA).  Open: chimerax view.cxc
open rna_motif2_METTL16.pdb
set bgColor white
hide atoms
cartoon
color /A #c8c8c8
color /A:135-142 #cb181d
show /A:135-142 atoms
style /A:135-142 stick
color /A:135-142 byhetero
color /B #d9b38c
nucleotides /B fill
show ligand
style ligand stick
color ligand byelement
hbonds /A:135-142 restrict /B | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA motif2: METTL16 catalytic region (m6A snRNA)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then:  save rna_motif2_METTL16.png width 2400 height 1800 supersample 3
