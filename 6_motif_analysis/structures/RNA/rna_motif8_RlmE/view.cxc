# RNA RlmE basic region (AlphaFold).  Open: chimerax view.cxc
open rna_motif8_RlmE.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:37-47 #e6550d
show /A:37-47 atoms
style /A:37-47 stick
color /A:37-47 byhetero
label /A:37-47 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "RNA motif8: RlmE basic region (AlphaFold)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save rna_motif8_RlmE.png width 2400 height 1800 supersample 3
