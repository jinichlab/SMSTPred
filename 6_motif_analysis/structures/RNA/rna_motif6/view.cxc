# RNA Trm5 N-terminal region.  Open: chimerax view.cxc
open rna_motif6.pdb
set bgColor white
hide atoms
cartoon
color /A #c8c8c8
color /A:45-55 #6a51a3
show /A:45-55 atoms
style /A:45-55 stick
color /A:45-55 byhetero
color /B #d9b38c
nucleotides /B fill
show ligand
style ligand stick
color ligand byelement
hbonds /A:45-55 restrict /B | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA motif6: Trm5 N-terminal region" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then:  save rna_motif6.png width 2400 height 1800 supersample 3
