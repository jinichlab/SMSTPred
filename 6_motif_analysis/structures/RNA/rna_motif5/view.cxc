# RNA RsmF region (apo).  Open: chimerax view.cxc
open rna_motif5.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:289-297 #238b45
show /A:289-297 atoms
style /A:289-297 stick
color /A:289-297 byhetero
label /A:289-297 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "RNA motif5: RsmF region (apo)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save rna_motif5.png width 2400 height 1800 supersample 3
