# RNA Trm5 SAM-binding DxGxGxG loop.  Open: chimerax view.cxc
open rna_motif3_SAMloop.pdb
set bgColor white
hide atoms
cartoon
color /A #c8c8c8
color /A:198-212 #2171b5
show /A:198-212 atoms
style /A:198-212 stick
color /A:198-212 byhetero
color /B #d9b38c
nucleotides /B fill
show ligand
style ligand stick
color ligand byelement
hbonds /A:198-212 restrict /B | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA motif3: Trm5 SAM-binding DxGxGxG loop" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then:  save rna_motif3_SAMloop.png width 2400 height 1800 supersample 3
