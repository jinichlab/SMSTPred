# RNA Trm5 basic RNA-binding patch (KKNIKLNK).  Open: chimerax view.cxc
open rna_motif7_basic.pdb
set bgColor white
hide atoms
cartoon
color /A #c8c8c8
color /A:233-240 #e6550d
show /A:233-240 atoms
style /A:233-240 stick
color /A:233-240 byhetero
color /B #d9b38c
nucleotides /B fill
show ligand
style ligand stick
color ligand byelement
hbonds /A:233-240 restrict /B | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "RNA motif7: Trm5 basic RNA-binding patch (KKNIKLNK)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then:  save rna_motif7_basic.png width 2400 height 1800 supersample 3
