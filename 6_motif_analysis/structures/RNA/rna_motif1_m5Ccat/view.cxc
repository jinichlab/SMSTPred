# RNA RsmF m5C catalytic PC (apo).  Open: chimerax view.cxc
open rna_motif1_m5Ccat.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:172-185 #cb181d
show /A:172-185 atoms
style /A:172-185 stick
color /A:172-185 byhetero
label /A:172-185 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "RNA motif1: RsmF m5C catalytic PC (apo)" xpos .03 ypos .04 size 15
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save rna_motif1_m5Ccat.png width 2400 height 1800 supersample 3
