# Other caffeic-acid OMT homolog (SAH+ferulate) [HOMOLOG].  Open: chimerax view.cxc
open other_motif7.pdb
set bgColor white
hide atoms
cartoon
color /E #cccccc
color /E:250-265 #00868b
show /E:250-265 atoms
style /E:250-265 stick
color /E:250-265 byhetero
label /E:250-265 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
color :FER gold
hbonds /E:250-265 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif7 (homolog): caffeic-acid OMT homolog (SAH+ferulate)" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif7.png width 2400 height 1800 supersample 3
