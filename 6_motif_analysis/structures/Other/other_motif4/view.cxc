# Other salicylate MTase homolog (SAH+salicylate) [HOMOLOG].  Open: chimerax view.cxc
open other_motif4.pdb
set bgColor white
hide atoms
cartoon
color /X #cccccc
color /X:128-145 #cb181d
show /X:128-145 atoms
style /X:128-145 stick
color /X:128-145 byhetero
label /X:128-145 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
color :SAL gold
hbonds /X:128-145 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif4 (homolog): salicylate MTase homolog (SAH+salicylate)" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif4.png width 2400 height 1800 supersample 3
