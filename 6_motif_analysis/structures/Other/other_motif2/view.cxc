# Other PFOMT homolog (SAH, no substrate) [HOMOLOG].  Open: chimerax view.cxc
open other_motif2.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:99-111 #6a51a3
show /A:99-111 atoms
style /A:99-111 stick
color /A:99-111 byhetero
label /A:99-111 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
hbonds /A:99-111 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif2 (homolog): PFOMT homolog (SAH, no substrate)" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif2.png width 2400 height 1800 supersample 3
