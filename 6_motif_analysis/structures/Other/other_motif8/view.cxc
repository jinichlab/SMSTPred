# Other caffeic-acid OMT homolog (SAH+ferulate) [HOMOLOG].  Open: chimerax view.cxc
open other_motif8.pdb
set bgColor white
hide atoms
cartoon
color /E #cccccc
color /E:227-237 #8c564b
show /E:227-237 atoms
style /E:227-237 stick
color /E:227-237 byhetero
label /E:227-237 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
color :FER gold
hbonds /E:227-237 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif8 (homolog): caffeic-acid OMT homolog (SAH+ferulate)" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif8.png width 2400 height 1800 supersample 3
