# Other caffeic-acid OMT homolog (SAH+ferulate) [HOMOLOG].  Open: chimerax view.cxc
open other_motif6.pdb
set bgColor white
hide atoms
cartoon
color /E #cccccc
color /E:268-280 #238b45
show /E:268-280 atoms
style /E:268-280 stick
color /E:268-280 byhetero
label /E:268-280 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
color :FER gold
hbonds /E:268-280 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif6 (homolog): caffeic-acid OMT homolog (SAH+ferulate)" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif6.png width 2400 height 1800 supersample 3
