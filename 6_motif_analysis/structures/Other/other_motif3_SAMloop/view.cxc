# Other caffeic-acid OMT homolog (SAH+ferulate) SAM Motif I loop [HOMOLOG].  Open: chimerax view.cxc
open other_motif3_SAMloop.pdb
set bgColor white
hide atoms
cartoon
color /E #cccccc
color /E:204-215 #ce1256
show /E:204-215 atoms
style /E:204-215 stick
color /E:204-215 byhetero
label /E:204-215 text "{0.label_one_letter_code}{0.number}" height 1.2
show ligand
style ligand stick
color ligand byelement
color :FER gold
hbonds /E:204-215 restrict ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Other motif3 (homolog): caffeic-acid OMT homolog (SAH+ferulate) SAM Motif I loop" xpos .03 ypos .04 size 13
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save other_motif3_SAMloop.png width 2400 height 1800 supersample 3
