# Protein HemK/PrmC region (AlphaFold).  Open: chimerax view.cxc
open protein_motif5_HemK.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:10-19 #e6550d
show /A:10-19 atoms
style /A:10-19 stick
color /A:10-19 byhetero
label /A:10-19 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "Protein motif5: HemK/PrmC region (AlphaFold)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif5_HemK.png width 2400 height 1800 supersample 3
