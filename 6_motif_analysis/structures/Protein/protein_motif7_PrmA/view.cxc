# Protein PrmA region (+L11 substrate).  Open: chimerax view.cxc
open protein_motif7_PrmA.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:98-114 #00868b
show /A:98-114 atoms
style /A:98-114 stick
color /A:98-114 byhetero
label /A:98-114 text "{0.label_one_letter_code}{0.number}" height 1.2
color /B #d9b38c
hbonds /A:98-114 restrict /B reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Protein motif7: PrmA region (+L11 substrate)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif7_PrmA.png width 2400 height 1800 supersample 3
