# Protein SET lysine-MTase region (AlphaFold).  Open: chimerax view.cxc
open protein_motif2_SET.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:336-350 #6a51a3
show /A:336-350 atoms
style /A:336-350 stick
color /A:336-350 byhetero
label /A:336-350 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "Protein motif2: SET lysine-MTase region (AlphaFold)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif2_SET.png width 2400 height 1800 supersample 3
