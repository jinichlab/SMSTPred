# Protein O-MTase region (AlphaFold).  Open: chimerax view.cxc
open protein_motif3.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:196-203 #238b45
show /A:196-203 atoms
style /A:196-203 stick
color /A:196-203 byhetero
label /A:196-203 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "Protein motif3: O-MTase region (AlphaFold)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif3.png width 2400 height 1800 supersample 3
