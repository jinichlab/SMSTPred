# Protein HemK catalytic NPPY (AlphaFold).  Open: chimerax view.cxc
open protein_motif8_HemK_NPPY.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:188-195 #8c564b
show /A:188-195 atoms
style /A:188-195 stick
color /A:188-195 byhetero
label /A:188-195 text "{0.label_one_letter_code}{0.number}" height 1.2
2dlabel text "Protein motif8: HemK catalytic NPPY (AlphaFold)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif8_HemK_NPPY.png width 2400 height 1800 supersample 3
