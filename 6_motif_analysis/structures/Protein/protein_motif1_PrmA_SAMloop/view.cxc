# Protein PrmA SAM Motif I loop (+L11 substrate).  Open: chimerax view.cxc
open protein_motif1_PrmA_SAMloop.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:126-141 #2171b5
show /A:126-141 atoms
style /A:126-141 stick
color /A:126-141 byhetero
label /A:126-141 text "{0.label_one_letter_code}{0.number}" height 1.2
color /B #d9b38c
hbonds /A:126-141 restrict /B reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Protein motif1: PrmA SAM Motif I loop (+L11 substrate)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif1_PrmA_SAMloop.png width 2400 height 1800 supersample 3
