# Protein PRMT5 region (+MEP50 partner).  Open: chimerax view.cxc
open protein_motif4_PRMT5.pdb
set bgColor white
hide atoms
cartoon
color /A #cccccc
color /A:429-445 #cb181d
show /A:429-445 atoms
style /A:429-445 stick
color /A:429-445 byhetero
label /A:429-445 text "{0.label_one_letter_code}{0.number}" height 1.2
color /B,/C #d9b38c
show ligand
style ligand stick
color ligand byelement
hbonds /A:429-445 restrict /B,/C | ligand reveal true color #303030 dashes 8 radius 0.05
2dlabel text "Protein motif4: PRMT5 region (+MEP50 partner)" xpos .03 ypos .04 size 14
lighting soft
graphics silhouettes true
view
# >>> rotate, then: save protein_motif4_PRMT5.png width 2400 height 1800 supersample 3
