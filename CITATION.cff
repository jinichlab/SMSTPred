cff-version: 1.2.0
message: "If you use this code or the data, please cite the manuscript (once published) and the Zenodo data record."
title: "SMSTPred: substrate-type prediction for SAM-dependent methyltransferases across the tree of life"
type: software
version: "1.0.0"
date-released: "2026-11-11"
authors:
  - family-names: Roethler
    given-names: Nathaniel
    orcid: "https://orcid.org/0009-0001-0143-2791"
    affiliation: "Department of Chemistry and Biochemistry, University of California San Diego"
  - family-names: Jinich
    given-names: Adrian
    orcid: "https://orcid.org/0000-0001-8616-9250"
    affiliation: "Department of Chemistry and Biochemistry and Skaggs School of Pharmacy and Pharmaceutical Sciences, University of California San Diego"
repository-code: "https://github.com/jinichlab/SMSTPred"
license: MIT
abstract: >-
  Multi-label classifier (DNA, RNA, Protein, Metabolite) of the substrate type of SAM-dependent methyltransferases from
  protein language-model embeddings (ProtT5; a six-member ensemble), with the cluster-disjoint benchmark, the ready-to-run
  classifier, predictions for 115,850 enzymes in 1,249 reference proteomes (UniProt release 2026_03), and the CLEAN / Horizyn
  and motif analyses of the manuscript, as one automated pipeline that can be rerun for each UniProt release.
keywords:
  - S-adenosylmethionine
  - methyltransferase
  - substrate specificity
  - protein language model
  - enzyme function prediction
  - tree of life
references:
  - type: dataset
    title: "SMSTPred data (UniProt release 2026_03): protein language-model embeddings, substrate-type labels, the deployed ensemble, tree-of-life predictions and analysis results for SAM-methyltransferase substrate prediction"
    authors:
      - family-names: Roethler
        given-names: Nathaniel
      - family-names: Jinich
        given-names: Adrian
    doi: 10.5281/zenodo.23655998
    year: 2026
