embeddings/spotcheck_output/
fresh_clone_*.out
verify_gpu_*.log

# Stage 0 UniProt pull output (large, regenerated by `make pull`; the small manifests in 0_uniprot_pull/pull_manifests/ are kept)
data/uniprot_pull/

